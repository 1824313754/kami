COMPOSE_PROJECT_NAME=pyfaka
PYFAKA_IMAGE=ghcr.io/1824313754/kami:main
PYFAKA_CONTAINER_NAME=pyfaka

# Host settings.
PYFAKA_DATA_DIR=./data
PYFAKA_BIND_ADDRESS=0.0.0.0
PYFAKA_HTTP_PORT=8099

# Replace both values before the first startup.
PYFAKA_SECRET_KEY=replace-with-openssl-rand-base64-48
PYFAKA_ADMIN_USERNAME=admin
PYFAKA_ADMIN_PASSWORD=replace-with-strong-password

# The release Compose file always uses the built-in SQLite database.

# Set to 1 when the site is served through HTTPS.
PYFAKA_COOKIE_SECURE=0
PYFAKA_SESSION_MINUTES=20
PYFAKA_TIMEZONE=Asia/Shanghai
TZ=Asia/Shanghai

# Upload limits in bytes / multipart parts.
PYFAKA_MAX_CONTENT_LENGTH=10737418240
PYFAKA_MAX_FORM_MEMORY_SIZE=67108864
PYFAKA_MAX_FORM_PARTS=50000

# Guest reauthorization. Leave proxy empty for direct OAuth access.
PYFAKA_REAUTH_PROXY=
PYFAKA_REAUTH_OTP_TIMEOUT=180
